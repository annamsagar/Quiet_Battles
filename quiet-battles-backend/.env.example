# ==============================================================================
# QUIET BATTLES™ BACKEND – ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with real local credentials.
# NEVER commit .env or files with real secrets to version control.
# ==============================================================================

# Server Port
SERVER_PORT=8081

# PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/quiet_battles_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# Spring Profiles (dev / prod / test)
SPRING_PROFILES_ACTIVE=dev

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

